{
  "name": "@luseefor/synthex-cli",
  "version": "1.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "synthex": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "@luseefor/synthex-core": "^1.2.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "node-diff3": "^3.2.1"
  },
  "scripts": {
    "build": "rm -rf ./dist && npx tsc -p tsconfig.build.json --emitDeclarationOnly && bun build ./src/index.ts --target=node --outfile=./dist/index.js && node ./scripts/copy-assets.mjs && chmod +x ./dist/index.js",
    "dev": "bun --watch run ./src/index.ts test",
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "sideEffects": false
}
