{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "outDir": "./dist",
    "noEmit": false,
    "paths": {
      "@synthex/core": ["../core/dist/index.d.ts"],
      "@synthex/core/*": ["../core/dist/*"]
    },
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
