{
  "name": "synthex-ui",
  "version": "1.1.0",
  "type": "module",
  "description": "Cross-platform React UI framework for consistent web and native product surfaces.",
  "license": "MIT",
  "main": "./dist/index.web.js",
  "module": "./dist/index.web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.web.js",
      "default": "./dist/index.web.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "react-native": "./dist/components/index.native.js",
      "import": "./dist/components/index.web.js",
      "default": "./dist/components/index.web.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "react-native": "./dist/primitives/index.native.js",
      "import": "./dist/primitives/index.web.js",
      "default": "./dist/primitives/index.web.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "react-native": "./dist/layout/index.native.js",
      "import": "./dist/layout/index.web.js",
      "default": "./dist/layout/index.web.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "react-native": "./dist/hooks/index.native.js",
      "import": "./dist/hooks/index.web.js",
      "default": "./dist/hooks/index.web.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "react-native": "./dist/icons/index.native.js",
      "import": "./dist/icons/index.web.js",
      "default": "./dist/icons/index.web.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "react-native": "./dist/theme/index.native.js",
      "import": "./dist/theme/index.web.js",
      "default": "./dist/theme/index.web.js"
    },
    "./blocks": {
      "types": "./dist/synthex/index.d.ts",
      "import": "./dist/synthex/index.js",
      "default": "./dist/synthex/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./web": {
      "types": "./dist/index.web.d.ts",
      "import": "./dist/index.web.js",
      "default": "./dist/index.web.js"
    },
    "./native": {
      "types": "./dist/index.native.d.ts",
      "import": "./dist/index.native.js",
      "default": "./dist/index.native.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luseefor/synthex-ui.git"
  },
  "homepage": "https://github.com/Luseefor/synthex-ui",
  "bugs": {
    "url": "https://github.com/Luseefor/synthex-ui/issues"
  },
  "keywords": [
    "react",
    "react-native",
    "ui",
    "design-system",
    "components",
    "tailwind"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "lucide-react": "^1.59.0",
    "lucide-react-native": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.81.0",
    "react-native-svg": "^15.16.0"
  },
  "peerDependenciesMeta": {
    "lucide-react-native": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "react-day-picker": "^9.6.0",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "lucide-react-native": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.81.0",
    "react-native-svg": "^15.16.0",
    "react-test-renderer": "^19.3.1",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "rm -rf ./dist && npx tsc -p tsconfig.build.json && cp ./src/styles.css ./dist/styles.css && cp ./src/tailwind.css ./dist/tailwind.css",
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "sideEffects": [
    "./dist/styles.css",
    "./dist/tailwind.css"
  ]
}
