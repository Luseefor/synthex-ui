{
  "name": "@synthex/ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.web.js",
  "module": "./dist/index.web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.web.js",
      "default": "./dist/index.web.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "react-native": "./dist/components/index.native.js",
      "import": "./dist/components/index.web.js",
      "default": "./dist/components/index.web.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "react-native": "./dist/primitives/index.native.js",
      "import": "./dist/primitives/index.web.js",
      "default": "./dist/primitives/index.web.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "react-native": "./dist/layout/index.native.js",
      "import": "./dist/layout/index.web.js",
      "default": "./dist/layout/index.web.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "react-native": "./dist/hooks/index.native.js",
      "import": "./dist/hooks/index.web.js",
      "default": "./dist/hooks/index.web.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "react-native": "./dist/icons/index.native.js",
      "import": "./dist/icons/index.web.js",
      "default": "./dist/icons/index.web.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "react-native": "./dist/theme/index.native.js",
      "import": "./dist/theme/index.web.js",
      "default": "./dist/theme/index.web.js"
    },
    "./styles.css": "./dist/styles.css",
    "./web": {
      "types": "./dist/index.web.d.ts",
      "import": "./dist/index.web.js",
      "default": "./dist/index.web.js"
    },
    "./native": {
      "types": "./dist/index.native.d.ts",
      "import": "./dist/index.native.js",
      "default": "./dist/index.native.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "lucide-react": "^0.542.0",
    "lucide-react-native": "^0.542.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.81.0",
    "react-native-svg": "^15.12.1"
  },
  "peerDependenciesMeta": {
    "lucide-react-native": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.542.0",
    "lucide-react-native": "^0.542.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.81.0",
    "react-native-svg": "^15.12.1",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "rm -rf ./dist && cd ./src && bun build ./index.ts ./index.web.ts ./index.native.ts ./components/index.web.ts ./components/index.native.ts ./primitives/index.web.tsx ./primitives/index.native.tsx ./layout/index.web.tsx ./layout/index.native.tsx ./hooks/index.web.ts ./hooks/index.native.ts ./icons/index.web.tsx ./icons/index.native.tsx ./theme/index.web.ts ./theme/index.native.ts --outdir ../dist --target browser --format esm --external react --external react-dom --external react-native --external react/jsx-runtime --external lucide-react --external lucide-react-native --external react-native-svg --sourcemap && cd .. && bunx tsc -p tsconfig.build.json && cp ./src/styles.css ./dist/styles.css",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "sideEffects": [
    "./dist/styles.css"
  ]
}
