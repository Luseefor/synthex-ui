{
  "name": "synthex-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "Cross-platform React UI framework for consistent web and native product surfaces.",
  "license": "MIT",
  "main": "./dist/index.web.js",
  "module": "./dist/index.web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "import": "./dist/index.web.js",
      "default": "./dist/index.web.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "react-native": "./dist/components/index.native.js",
      "import": "./dist/components/index.web.js",
      "default": "./dist/components/index.web.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "react-native": "./dist/primitives/index.native.js",
      "import": "./dist/primitives/index.web.js",
      "default": "./dist/primitives/index.web.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "react-native": "./dist/layout/index.native.js",
      "import": "./dist/layout/index.web.js",
      "default": "./dist/layout/index.web.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "react-native": "./dist/hooks/index.native.js",
      "import": "./dist/hooks/index.web.js",
      "default": "./dist/hooks/index.web.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "react-native": "./dist/icons/index.native.js",
      "import": "./dist/icons/index.web.js",
      "default": "./dist/icons/index.web.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "react-native": "./dist/theme/index.native.js",
      "import": "./dist/theme/index.web.js",
      "default": "./dist/theme/index.web.js"
    },
    "./styles.css": "./dist/styles.css",
    "./web": {
      "types": "./dist/index.web.d.ts",
      "import": "./dist/index.web.js",
      "default": "./dist/index.web.js"
    },
    "./native": {
      "types": "./dist/index.native.d.ts",
      "import": "./dist/index.native.js",
      "default": "./dist/index.native.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Luseefor/synthex-ui.git"
  },
  "homepage": "https://github.com/Luseefor/synthex-ui",
  "bugs": {
    "url": "https://github.com/Luseefor/synthex-ui/issues"
  },
  "keywords": [
    "react",
    "react-native",
    "ui",
    "design-system",
    "components",
    "tailwind"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "lucide-react": "^0.542.0",
    "lucide-react-native": "^0.542.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.81.0",
    "react-native-svg": "^15.12.1"
  },
  "peerDependenciesMeta": {
    "lucide-react-native": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.542.0",
    "lucide-react-native": "^0.542.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.81.0",
    "react-native-svg": "^15.12.1",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "rm -rf ./dist && npx tsc -p tsconfig.build.json && cp ./src/styles.css ./dist/styles.css",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "sideEffects": [
    "./dist/styles.css"
  ]
}