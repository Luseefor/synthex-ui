{
  "name": "@luseefor/synthex-react-web",
  "version": "1.2.0",
  "type": "module",
  "description": "React DOM adapter for rendering Synthex layout engine workspaces.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/index.web.d.ts",
      "import": "./dist/index.web.js",
      "default": "./dist/index.web.js"
    }
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@luseefor/synthex-core": "^1.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luseefor/synthex-ui.git"
  },
  "homepage": "https://github.com/Luseefor/synthex-ui",
  "bugs": {
    "url": "https://github.com/Luseefor/synthex-ui/issues"
  },
  "keywords": [
    "react",
    "layout",
    "workbench",
    "split-view",
    "tabs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf ./dist && npx tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "npx tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false
}
