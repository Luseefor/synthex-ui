{
  "name": "@synthex/core",
  "version": "1.0.0",
  "type": "module",
  "description": "Framework-agnostic layout and command engine for Synthex UI.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Luseefor/synthex-ui.git"
  },
  "homepage": "https://github.com/Luseefor/synthex-ui",
  "bugs": {
    "url": "https://github.com/Luseefor/synthex-ui/issues"
  },
  "keywords": [
    "layout-engine",
    "commands",
    "serialization",
    "typescript",
    "headless"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf ./dist && bun build ./src/index.ts --outdir ./dist --target bun --format esm --sourcemap && bunx tsc -p tsconfig.build.json",
    "dev": "bun --watch run ./src/index.ts",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false
}
